[Unit]
Description=HKO Weather Monitor & Polymarket Paper Trading System
After=network.target

[Service]
Type=simple
User=hermes-runner
Group=hermes-runner
WorkingDirectory=/shared-hermes/hko_weather_monitor
Environment="PYTHONPATH=/shared-hermes/hko_weather_monitor"
ExecStart=/usr/bin/python3 -m hko_weather_monitor.dashboard
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
